# Istari Sales Bot Morgana — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# ── SLACK ─────────────────────────────────────────────────
# Bot token (xoxb-) and app-level token (xapp-, needs connections:write for Socket Mode)
# from your Slack app's OAuth & Permissions / Basic Information pages.
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# The one channel the bot answers in. Default is the POC channel.
BOT_CHANNEL_ID=C0BH2CE7LBB

# OPTIONAL — user token (xoxp-) to enable Slack SEARCH across channels.
# Bot tokens cannot call search.messages, so without this the Slack source falls
# back to reading recent history of BOT_CHANNEL_ID only. Add a User Token Scope
# `search:read` to the app, (re)install, then copy the "User OAuth Token".
# Searches as THAT user (only what they can see). Treat like a password.
# SLACK_USER_TOKEN=xoxp-your-user-token-here

# ── CLAUDE ────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-your-claude-key-here
# Model is configurable; default matches the internal signal-bot. Bump to a
# Claude 5 model (e.g. claude-sonnet-5) when ready.
# CLAUDE_MODEL=claude-sonnet-4-6

# DEVELOPER/OPS ONLY. When true, the bot traces each tool call + raw result to the
# SERVER console (stderr). Never shown to Slack users. Leave unset in normal use.
# BOT_DEBUG=false

# ── ATLASSIAN (Jira + Confluence, read-only) ──────────────
# One Atlassian Cloud credential covers both Jira and Confluence.
JIRA_URL=https://istari.atlassian.net
JIRA_EMAIL=you@istaridigital.com
JIRA_API_TOKEN=your-atlassian-api-token-here
# Confluence lives under the same site by default; override only if different.
# CONFLUENCE_URL=https://istari.atlassian.net/wiki

# ── GITHUB (read-only) ────────────────────────────────────
# Use the token that already works over HTTPS for the org (repo + read:org, read-only use).
GITHUB_TOKEN=ghp-your-token-here
GITHUB_ORG=istari-digital-internal

# ── HUBSPOT (read-only CRM: deals, companies, contacts) ───
# A HubSpot Private App access token. Grant it READ scopes only:
# crm.objects.deals.read, crm.objects.companies.read, crm.objects.contacts.read.
# Create at: HubSpot → Settings → Integrations → Private Apps.
# HUBSPOT_TOKEN=pat-na1-your-private-app-token-here
# Optional — your hub/portal id, only used to build clickable record links.
# HUBSPOT_PORTAL_ID=

# ── ISTARI PLATFORM (optional, read-only) ─────────────────
# Wired but OFF until both are set. Needs a reachable REST base URL + token.
# ISTARI_API_URL=https://api.istaridigital.com
# ISTARI_API_TOKEN=your-istari-token-here
